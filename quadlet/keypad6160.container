[Unit]
Description=6160 Keypad MQTT Service
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/brianegge/keypad6160:latest
AutoUpdate=registry
Pull=newer
EnvironmentFile=%h/.config/containers/systemd/keypad6160.env
AddDevice=/dev/ttyACM0
Label=io.containers.autoupdate=registry
# Run as non-root; the keypad user in the container is in the dialout group
SecurityLabelDisable=true

[Service]
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
