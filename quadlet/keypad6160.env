# Serial device
KEYPAD_SERIAL_DEVICE=/dev/ttyACM0
KEYPAD_SERIAL_BAUDRATE=115200

# MQTT broker (HomeAssistant Mosquitto add-on)
KEYPAD_MQTT_HOST=homeassistant.local
KEYPAD_MQTT_PORT=1883
KEYPAD_MQTT_USERNAME=
KEYPAD_MQTT_PASSWORD=
KEYPAD_MQTT_CLIENT_ID=keypad6160
KEYPAD_MQTT_TOPIC_PREFIX=homeassistant/6160

# Logging
KEYPAD_LOG_LEVEL=INFO
